            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nouveau User\",\n  \"email\": \"nouveau@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"user\",\n  \"phone\": \"+261340000000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
